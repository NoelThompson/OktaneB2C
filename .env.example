# Oktane B2C — configuration reference.
#
# Nothing here is required to run the mock-mode demo: every value below has a
# working default. Copy the blocks you need into apps/agent/.env,
# apps/web/.env.local, and packages/mcp-server/.env when you point the demo at a
# real Okta org. Never commit the filled-in files.

# ---- agent (apps/agent/.env) ------------------------------------------------

# mock = the agent runs a local authorization server, mints real RS256 tokens,
# and serves the JWKS the MCP server verifies against. okta = the same code
# paths point at a real org.
DEMO_MODE=mock
AGENT_HOST=127.0.0.1
AGENT_PORT=8788
AGENT_PUBLIC_BASE=http://localhost:8788
WEB_BASE=http://localhost:3000
MCP_URL=http://localhost:8787

# Optional. Without a key the assistant uses its deterministic script, which is
# what the demo narrative is written against.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ---- Okta (only when DEMO_MODE=okta) ---------------------------------------

OKTA_DOMAIN=
# The agent's workload principal id *is* its OIDC client id (wlp...), produced
# by agent registration — not by Terraform.
OKTA_AGENT_CLIENT_ID=
# Private JWK for private_key_jwt client auth. Generated locally by
# scripts/gen-agent-key.mjs; only the public half goes to Okta/Terraform.
OKTA_AGENT_PRIVATE_KEY_JWK=

# mock | raw | sdk
TOKEN_EXCHANGE_IMPL=mock

OKTA_CATALOG_ISSUER=
OKTA_ORDERS_ISSUER=
OKTA_CATALOG_AUDIENCE=api://oktane-catalog
OKTA_ORDERS_AUDIENCE=api://oktane-orders

# ---- human-in-the-loop -----------------------------------------------------

APPROVAL_TTL_SECONDS=900
# How recently the second factor must have happened. This is what max_age=0
# buys us, and it is why acr alone is not sufficient proof.
STEPUP_FRESHNESS_SECONDS=120
# Verification fails closed when this claim is absent: Okta silently ignores
# acr_values it does not recognise, so a typo would otherwise look like success.
REQUIRED_ACR=urn:okta:loa:2fa:any

# ---- MCP server (packages/mcp-server/.env) ---------------------------------

# scripts/dev.sh sets this to true and points the issuers at the agent's mock
# authorization servers, so scope is enforced for real with no Okta org.
MCP_REQUIRE_AUTH=true
MCP_PORT=8787
OKTANE_DB_PATH=

# ---- web (apps/web/.env.local) ---------------------------------------------

# The only variable the web app reads. The "Simulate restock" trigger and the
# demo shopper switcher follow the agent's own DEMO_MODE, reported by the agent.
AGENT_URL=http://localhost:8788
